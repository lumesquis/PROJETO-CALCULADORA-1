#!/bin/bash

somar() {
    echo $(($1 + $2))
}

subtrair() {
    echo $(($1 - $2))
}

multiplicar() {
    echo $(($1 * $2))
}

dividir() {
    if [ $2 -eq 0 ]; then
        echo "Erro: Divisão por zero não é permitida!"
    else
        # Usa 'bc' ou $(( )) para divisão. 
        # O Bash faz apenas divisão inteira nativamente.
        echo $(($1 / $2))
    fi
}

exibir_menu() {
    echo -e "\n=== CALCULADORA SIMPLES ==="
    echo "1. Soma (+)"
    echo "2. Subtração (-)"
    echo "3. Multiplicação (*)"
    echo "4. Divisão (/)"
    echo "5. Sair"
}

executar_calculadora() {
    while true; do
        exibir_menu
        read -p "Escolha uma opção (1-5): " opcao

        case $opcao in
            1)
                read -p "Digite o primeiro número: " a
                read -p "Digite o segundo número: " b
                echo -e "\nResultado: $(somar $a $b)"
                ;;
            2)
                read -p "Digite o primeiro número: " a
                read -p "Digite o segundo número: " b
                echo -e "\nResultado: $(subtrair $a $b)"
                ;;
            3)
                read -p "Digite o primeiro número: " a
                read -p "Digite o segundo número: " b
                echo -e "\nResultado: $(multiplicar $a $b)"
                ;;
            4)
                read -p "Digite o primeiro número: " a
                read -p "Digite o segundo número: " b
                echo -e "\nResultado: $(dividir $a $b)"
                ;;
            5)
                echo "Saindo..."
                break
                ;;
            *)
                echo "Opção inválida! Tente novamente."
                ;;
        esac
    done
}

executar_calculadora
